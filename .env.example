# Set these to the output of id -u and id -g on Linux.
PUID=1000
PGID=1000

# Required origin: https://hostname[:port], without credentials, path, query or fragment.
# Development HTTP is allowed only for localhost, 127.0.0.1 or [::1], with the flag below.
IGNIS_PUBLIC_ORIGIN=http://localhost:8080
# Valid values: true or false (lowercase). Use false outside local development.
IGNIS_ALLOW_HTTP_LOOPBACK=true
# JSON array of 0–32 trusted proxy IPv4/IPv6 addresses or CIDRs; [] trusts none.
# Example: ["172.20.0.2", "10.0.0.0/24"]. CIDR prefixes: IPv4 0–32, IPv6 0–128.
# No hostnames, booleans or hop counts; include only proxies you control.
IGNIS_TRUSTED_PROXIES=[]

# Optional first-admin web setup. Empty disables it; the CLI remains available.
# Valid value: empty, or exactly 32 lowercase hexadecimal characters (0–9, a–f).
# Generate a unique key with: openssl rand -hex 16
# Remove the key after setup. Never commit real secrets.
IGNIS_INITIAL_ADMIN_KEY=
# Alternative runtime setting: IGNIS_INITIAL_ADMIN_KEY_FILE=/run/secrets/ignis_initial_admin_key
# Mount the file and pass its container path in Compose; do not configure both sources.
# File content: the same 32 hex characters, optionally followed by one LF or CRLF.

# Applies to new local passwords in both CLI and web setup; existing logins are unchanged.
# Valid range: 8–128 inclusive; default: 8. Counts Unicode code points.
# Use decimal integers without signs, spaces, fractions or leading zeros.
# Invalid values (e.g. 6) prevent startup; passwords are capped at 1024 UTF-8 bytes.
IGNIS_PASSWORD_MIN_LENGTH=8
# Valid range: 0–IGNIS_PASSWORD_MIN_LENGTH inclusive; default/recommended: 0.
# 0 disables this requirement; 1 requires at least one punctuation/symbol character.
# Counts Unicode punctuation/symbols (e.g. !, *, €); spaces and letters do not count.
IGNIS_PASSWORD_MIN_SPECIAL_CHARS=0
