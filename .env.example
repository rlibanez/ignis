# Set these to the output of id -u and id -g on Linux.
PUID=1000
PGID=1000

# Required origin: https://hostname[:port], without credentials, path, query or fragment.
# Explicit HTTP development exceptions below also permit http://host[:port].
# Loopback HTTP development uses localhost, 127.0.0.1 or [::1] with the flag below.
IGNIS_PUBLIC_ORIGIN=http://localhost:8080
# Valid values: true or false (lowercase). Use false outside local development.
IGNIS_ALLOW_HTTP_LOOPBACK=true
# Optional LAN development exception: true | false. Default false.
# Allows HTTP only for a literal private IPv4 origin: 10/8, 172.16/12, 192.168/16.
# Passwords and session cookies travel unencrypted. Use only on a trusted test LAN.
# Example: IGNIS_PUBLIC_ORIGIN=http://192.168.2.9:8080, with LOOPBACK=false.
# Publish the Docker port on that IP (or all interfaces) to allow remote devices.
IGNIS_ALLOW_HTTP_PRIVATE_NETWORK=false
# JSON array of 0–32 trusted proxy IPv4/IPv6 addresses or CIDRs; [] trusts none.
# Example: ["172.20.0.2", "10.0.0.0/24"]. CIDR prefixes: IPv4 0–32, IPv6 0–128.
# No hostnames, booleans or hop counts; include only proxies you control.
# With HTTPS terminated at a proxy, trust only that proxy and preserve Host.
# Forwarded headers from other peers are rejected; do not trust all addresses.
IGNIS_TRUSTED_PROXIES=[]

# Optional first-admin web setup. Empty disables it; the CLI remains available.
# Valid value: empty, or exactly 32 lowercase hexadecimal characters (0–9, a–f).
# Generate a unique key with: openssl rand -hex 16
# Remove the key after setup. Never commit real secrets.
IGNIS_INITIAL_ADMIN_KEY=
# Alternative runtime setting: IGNIS_INITIAL_ADMIN_KEY_FILE=/run/secrets/ignis_initial_admin_key
# Mount the file and pass its container path in Compose; do not configure both sources.
# File content: the same 32 hex characters, optionally followed by one LF or CRLF.

# Applies to new local passwords in both CLI and web setup; existing logins are unchanged.
# Valid range: 8–128 inclusive; default: 8. Counts Unicode code points.
# Use decimal integers without signs, spaces, fractions or leading zeros.
# Invalid values (e.g. 6) prevent startup; passwords are capped at 1024 UTF-8 bytes.
IGNIS_PASSWORD_MIN_LENGTH=8
# Valid range: 0–IGNIS_PASSWORD_MIN_LENGTH inclusive; default/recommended: 0.
# 0 disables this requirement; 1 requires at least one punctuation/symbol character.
# Counts Unicode punctuation/symbols (e.g. !, *, €); spaces and letters do not count.
IGNIS_PASSWORD_MIN_SPECIAL_CHARS=0

# OpenID Connect: optional confidential client. Restart after changing configuration.
# true | false. Disabled by default; invalid local configuration stops startup.
# Provider discovery runs on the first OIDC attempt; outages do not prevent local login.
IGNIS_OIDC_ENABLED=false
# Provider display name used throughout the UI: max 80 printable characters.
# Empty uses "OpenID Connect". Set only the name, e.g. "Authentik", not "Sign in with Authentik".
IGNIS_OIDC_BUTTON_TEXT=
# Exact HTTPS issuer, including its path/trailing slash. No credentials, query or fragment.
# Examples (replace host, realm or application slug):
# Keycloak: https://keycloak.example.com/realms/<realm>
#   Include a deployment prefix if configured, e.g. https://keycloak.example.com/auth/realms/<realm>
# Authentik: https://authentik.example.com/application/o/<application-slug>/
#   Use per-provider issuer mode (default). Keep the trailing slash.
#   Global issuer mode needs a separate discovery-location arrangement and is not supported directly here.
# Authelia: https://auth.example.com
# Copy the exact "issuer" field from the provider's OpenID discovery JSON.
# Do NOT put the /.well-known/openid-configuration URL in this variable.
IGNIS_OIDC_ISSUER=
IGNIS_OIDC_CLIENT_ID=
# Exactly one nonempty secret source when enabled. Never commit a real secret.
IGNIS_OIDC_CLIENT_SECRET=
# Absolute container path, mounted separately. Regular UTF-8 file, max 4096 secret bytes.
IGNIS_OIDC_CLIENT_SECRET_FILE=
# Register this exact redirect URI in the provider:
# <IGNIS_PUBLIC_ORIGIN>/api/auth/oidc/callback
# Enable Authorization Code, client_secret_basic, PKCE S256 and RS256 ID Tokens.

# Automatic creation of normal users without local passwords or vault permissions.
# true | false. Default: false. Requires an existing administrator.
IGNIS_OIDC_AUTO_PROVISION=false
# Initial linking only; subsequent logins use the stored issuer + subject.
# disabled | preferred_username | verified_email | preferred_username_and_verified_email
# Combined mode requires BOTH matches on the same account; no fallback.
# Email modes require a trusted local email AND provider email_verified=true.
# Automatic linking never targets administrators or disabled accounts.
IGNIS_OIDC_ACCOUNT_LINKING=disabled

# Additional allowed HTTPS endpoint origins, JSON array; issuer origin is included automatically.
# Example: ["https://keys.example.com"]. Maximum 16 total origins.
IGNIS_OIDC_ALLOWED_ORIGINS=[]
# JSON object mapping an allowed origin to exact private IP exceptions (max 32 per origin).
# Example: {"https://auth.example.com":["192.168.1.20"]}
# RFC1918, ULA or loopback only. No CIDRs/link-local. Every DNS result must be allowed.
IGNIS_OIDC_PRIVATE_ADDRESSES={}
# Optional PEM CA bundle, absolute container path mounted separately (max 1 MiB).
# Replaces this client's default CA list; TLS hostname verification remains mandatory.
IGNIS_OIDC_CA_FILE=

# Shared resources: maximum file size for reads, downloads, edits and uploads.
# Integer 1–128 MiB inclusive; default 8. 1 MiB = 1048576 bytes.
# No signs, spaces, fractions or leading zeros. Empty/invalid values prevent startup.
# Files are buffered in memory and Base64-encoded; larger limits need more RAM.
# Recreate the container after changing this value. Proxy body limits may also apply.
IGNIS_SHARED_RESOURCE_MAX_FILE_MIB=8
