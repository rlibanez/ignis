# Set these to the output of id -u and id -g on Linux.
PUID=1000
PGID=1000

# Local development only. Use HTTPS and false outside loopback.
IGNIS_PUBLIC_ORIGIN=http://localhost:8080
IGNIS_ALLOW_HTTP_LOOPBACK=true
# JSON array of trusted reverse proxy IPs/CIDRs; never trust forwarded headers globally.
IGNIS_TRUSTED_PROXIES=[]
